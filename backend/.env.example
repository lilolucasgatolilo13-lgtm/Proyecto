# Copiar este archivo a .env y completar los valores

# Secreto para autenticar los endpoints de jobs internos (C-01)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO

# Ruta de la base de datos SQLite (B-02)
# DB_PATH=./data/comiqueria.db

# Entorno: development | production
NODE_ENV=development
